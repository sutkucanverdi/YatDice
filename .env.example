# ==========================================================
# YAT DICE - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# Gerçek kullanımda bu dosyayı `.env` olarak kopyalayıp
# şifreleri ve gizli anahtarları kendinize göre değiştirin.
# ==========================================================

# PostgreSQL (docker-compose için)
POSTGRES_USER=yatzy_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=yatzy_gamedb

# Go Backend Ayarları
PORT=8080
DATABASE_URL=postgres://yatzy_user:change_this_strong_password@localhost:5432/yatzy_gamedb?sslmode=disable
JWT_SECRET=replace-with-a-long-random-256-bit-secret-key
ALLOWED_ORIGIN=http://localhost:5173

# React Frontend (Vite) Ayarları
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
