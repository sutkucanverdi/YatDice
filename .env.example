# ==========================================================
# YAT DICE — ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# Yerelde bu dosyayı `.env` olarak kopyalamanız yeterlidir.
# APP_ENV=development değilse sunucu üretim kuralları ile
# çalışır: güçlü JWT_SECRET ve DATABASE_URL olmadan açılmaz.
# ==========================================================

# PostgreSQL (docker-compose için)
POSTGRES_USER=yatzy_user
POSTGRES_PASSWORD=yatzy_password
POSTGRES_DB=yatzy_gamedb

# Go Backend Ayarları (yat-dice-backend otomatik olarak .env dosyasını okur)
PORT=8080
APP_ENV=development
DATABASE_URL=host=localhost port=5432 user=yatzy_user password=yatzy_password dbname=yatzy_gamedb sslmode=disable
# Üretimde en az 32 karakter ve rastgele olmalıdır (örnek: openssl rand -hex 32)
JWT_SECRET=dev-secret-change-in-production
# Virgülle ayrılmış Google OAuth istemci kimlikleri (web, Android, iOS). Boşsa Google girişi kapalıdır.
GOOGLE_CLIENT_ID=
ALLOWED_ORIGIN=*
# Sunucunun önündeki güvenilir proxy sayısı. 0 ise X-Forwarded-For yok sayılır.
TRUSTED_PROXY_COUNT=0

# Şifre sıfırlama e-postaları (587 portu ve STARTTLS). Geliştirmede kod ekranda gösterilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Yeni şikâyetlerin bildirileceği adres (isteğe bağlı)
REPORT_NOTIFY_EMAIL=

# /admin moderasyon paneli. En az 32 karakter olmalı; boşsa panel kapalıdır.
ADMIN_TOKEN=

# Sign in with Apple. Bundle id virgülle eklenir. Boşsa Apple girişi kapalıdır.
APPLE_CLIENT_IDS=
# Hesap silinince Apple yetkisini geri almak için (Apple Developer > Keys)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM içeriği, satır sonları \n olarak tek satırda
APPLE_PRIVATE_KEY=

# Gizlilik Politikası ve Kullanım Koşulları'nda görünen bilgiler
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=

# React Frontend (Vite) Ayarları (bunları yat-dice/.env dosyasına yazın)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
# Boşsa Google giriş butonu gösterilmez. Web, Android ve iOS sunucu kimliği olarak kullanılır.
VITE_GOOGLE_CLIENT_ID=
# iOS uygulaması için Google istemci kimliği
VITE_GOOGLE_IOS_CLIENT_ID=
