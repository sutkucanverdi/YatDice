# ==========================================================
# YAT DICE — ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# Yerel geliştirmede varsayılan değerler otomatik çalışır.
# Üretim (Production) ortamında bu dosyayı `.env` olarak
# kopyalayıp şifreleri ve gizli anahtarları değiştirin.
# ==========================================================

# PostgreSQL (docker-compose için)
POSTGRES_USER=yatzy_user
POSTGRES_PASSWORD=yatzy_password
POSTGRES_DB=yatzy_gamedb

# Go Backend Ayarları (yat-dice-backend otomatik olarak .env dosyasını okur)
PORT=8080
APP_ENV=development
DATABASE_URL=host=localhost port=5432 user=yatzy_user password=yatzy_password dbname=yatzy_gamedb sslmode=disable
JWT_SECRET=dev-secret-change-in-production
GOOGLE_CLIENT_ID=
ALLOWED_ORIGIN=*

# React Frontend (Vite) Ayarları
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
